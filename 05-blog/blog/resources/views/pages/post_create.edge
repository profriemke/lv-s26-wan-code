<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
<h1>Post createn</h1>

  <form action="/post/create" method="post" enctype="multipart/form-data">
    {{ csrfField() }}
    <input type="text" name="title" placeholder="Titel"><br>
    <input type="text" name="teaser" placeholder="Teaser"><br>
    <textarea name="text" cols="50" rows="10" placeholder="Text"></textarea><br>
    <input type="file" name="image"><br>
    <input type="submit" value="Post erstellen">
  </form>
</body>
</html>