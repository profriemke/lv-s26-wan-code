@include('partials/html-header')

<body>
  @include('partials/menu')

  <h1>Mein Blog</h1>
  <span class="material-symbols-outlined">
    swipe_vertical
  </span>
  @if(session.get('login')!= undefined)
  Hallo {{ session.get('firstname') }}!
  <p>
    <a href="/post/create">Post erstellen</a>
    <br>
    <a href="/logout">Logout</a>
  </p>
  @else
  <a href="/login">zum Login</a> <a href="/register">registrieren</a>
  @end

  @each(post in posts)
  <p>
  <h2>{{ post.title }}</h2>
  <small>{{ post.date }}</small>
  <p>
    {{ post.teaser }} <a href="/article/{{ post.id }}">mehr...</a>
    <br><small>{{ post.author }}</small>
  </p>
  </p>
  @end
  @include('partials/footer')
</body>

</html>