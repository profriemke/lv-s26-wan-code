<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>
  <h1>Mein Blog</h1>
  Welcome.
  <p>
    <a href="/post/create">Post erstellen</a>
  </p>
  @each(post in posts)
    <p>
      <h2>{{ post.title }}</h2>
      <small>{{ post.date }}</small>
      <p>
        {{ post.teaser }} <a href="/article/{{ post.id }}">mehr...</a>
        <br><small>{{ post.author }}</small>
      </p>
    </p>
  @end
</body>
</html>
