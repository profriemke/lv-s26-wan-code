<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Edit: {{ post.title }}</h1>
    <form action="/post/update" method="post">
      {{ csrfField() }}
    <input type="hidden" name="id" value="{{ post.id }}">  
    <input type="text" name="title" placeholder="Titel" value="{{ post.title}}"><br>
    <input type="text" name="teaser" placeholder="Teaser" value="{{ post.teaser}}"><br>
    <textarea name="text" cols="50" rows="10" placeholder="Text">{{ post.text }}</textarea><br>
    <input type="submit" value="Post ändern">
    </form>
    
</body>
</html>