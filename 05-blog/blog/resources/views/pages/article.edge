<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ post.title }} - Mein Blog</title>
</head>
<body>
    <h1>{{ post.title }}</h1>
    <p>
        {{ post.text }}
    </p>
    <p>
        {{ new Date(post.date).toLocaleDateString() }}/{{ post.author }}
        <br>
        <a href="/">zur Homepage</a>
    </p>
</body>
</html>