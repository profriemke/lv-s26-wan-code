<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>
    <h1>Hallo</h1>
    Hallo {{ name }}!!<br>
    Wir wünschen einen schönen {{ tag }}.
    <br>
    @if(anzeigeFreunde == true)
      <ul>
          @each((freund, index) in freunde)
            <li>{{ index + 1 }}. {{ freund }}</li>
          @end
    </ul>
    @else
      keine Freunde
    @end
    </body>
</html>